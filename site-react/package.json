{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"pnpm run build --watch\" \"pnpm run watch:rust\"",
    "build": "rsbuild build",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "watch:react": "pnpm run build -- --watch",
    "watch:rust": "cd ../backend && cargo watch -x \"run 127.0.0.1:5000 ../site-react/dist\""
  },
  "dependencies": {

  },
  "devDependencies": {
    "@rsbuild/core": "^1.2.15",
    "@rsbuild/plugin-react": "^1.1.1",
    "@rspack/cli": "^1.2.7",
    "@rspack/core": "^1.2.7",
    "@rspack/dev-server": "^1.0.10",
    "@rspack/plugin-react-refresh": "^1.0.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "20.16.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "react-refresh": "^0.16.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "protobufjs"
    ]
  }
}
